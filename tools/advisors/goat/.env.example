# Optionnel. La salle marche sans ce fichier : elle rejoue les conseils que tu lances dans Claude Code avec /goat.
#
# Pour que la salle lance elle-même un conseil (facturé sur ton compte API Anthropic,
# une douzaine d'appels par conseil), copie ce fichier en .env et remplis :

# Clé API Anthropic : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# "viewer" (par défaut) ou "api"
COUNCIL_RUNNER=viewer
