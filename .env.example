# Copier en .env (jamais versionné) et remplacer TOUTES les valeurs.
DB_OWNER_PASSWORD=changez-moi-long-et-aleatoire
APP_DB_PASSWORD=changez-moi-long-et-aleatoire
JWT_SECRET=changez-moi-au-moins-48-caracteres-aleatoires
# Origines autorisées si le portail est sur un autre domaine (vide = même domaine)
CORS_ORIGINS=
# Jeton pour /v1/metrics (vide = route désactivée)
METRICS_TOKEN=
# Port exposé du portail (placer un reverse proxy HTTPS devant)
WEB_PORT=8080
